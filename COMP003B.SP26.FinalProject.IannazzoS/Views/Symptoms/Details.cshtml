@model COMP003B.SP26.FinalProject.IannazzoS.Models.Symptom

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Symptom</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
</div>

<!--Display symptoms for patients-->
<div class="col-md-4">
    <h4>Patients</h4>
    <ul>
        @foreach (Patient patient in ViewBag.Patients)
        {
            <li>@patient.Name</li>
        }
    </ul>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.SymptomId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
